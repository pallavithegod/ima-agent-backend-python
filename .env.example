# --- Database -------------------------------------------------------------
# Local (host) runs; docker compose overrides the host to "postgres".
# Host port is 5433 to avoid clashing with a native Postgres on 5432.
DATABASE_URL=postgresql+psycopg://recallops:recallops@localhost:5433/recallops
POSTGRES_PASSWORD=recallops

# --- Auth (must keep the values the Node backend used) ----------------------
AUTH_JWT_SECRET=development-only-secret-change-me
CREDENTIAL_ENCRYPTION_KEY=
# Base64 of the Firebase service-account JSON (preferred), or place
# service-account.json in the repo root.
FIREBASE_SERVICE_ACCOUNT_BASE64=

# --- CORS / URLs ------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# --- Vercel OAuth (optional; PAT connect works without it) ------------------
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=
VERCEL_CALLBACK_URL=http://localhost:8000/api/integrations/vercel/callback
VERCEL_SCOPES=openid profile email offline_access

# --- AI pipeline ------------------------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
HINDSIGHT_API_URL=
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=incident-memory-agent
GITHUB_DEFAULT_BRANCH=main
VERCEL_TARGET=production

# --- Monitors ---------------------------------------------------------------
# 0 disables the commit monitor.
MONITOR_INTERVAL_MS=60000
VM_EVENT_COOLDOWN_SECONDS=600
VM_HEARTBEAT_TIMEOUT_SECONDS=60

# --- Clone-based fixer ------------------------------------------------------
WORKSPACES_DIR=./storage/workspaces
FIXER_MAX_FILES=5
FIXER_MAX_CHANGED_LINES=400

# --- Frontend build (docker compose) ----------------------------------------
FRONTEND_API_URL=http://localhost:8000
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# --- Demo project VMs (fill in after POST /api/vms) --------------------------
APP_ONE_VM_ID=
APP_ONE_VM_KEY=
APP_TWO_VM_ID=
APP_TWO_VM_KEY=
